# Server
PORT=3000
NODE_ENV=development

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI (site analysis, etc.)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# Tavily Search (URL suggestions) — https://app.tavily.com/
TAVILY_API_KEY=
# Optional: basic | fast | ultra-fast | advanced (default basic)
# TAVILY_SEARCH_DEPTH=basic
# Country boost for Tavily (default: france if unset). Set TAVILY_COUNTRY=none for no regional bias.
