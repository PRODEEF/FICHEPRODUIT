# Serveur
PORT=3000
NODE_ENV=development

# CORS — origines séparées par des virgules. En production : domaine(s) du front uniquement, pas *.
CORS_ORIGIN=http://localhost:5173

# Cookie session invité (durée en secondes, défaut 30 jours)
# GUEST_SESSION_COOKIE_MAX_AGE_SEC=2592000
# Traces scrape-fields (dev uniquement)
# SCRAPE_FIELDS_TRACE_DIR=logs/scrape-fields

# Supabase — Dashboard > Settings > API
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=eyJ...          # clé anon/public
SUPABASE_SERVICE_ROLE_KEY=eyJ...  # clé service_role (ne jamais exposer côté client)

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Tavily (suggest-urls)
TAVILY_API_KEY=tvly-...
TAVILY_SEARCH_DEPTH=basic         # basic | advanced
TAVILY_COUNTRY=france             # ou "none" pour désactiver
