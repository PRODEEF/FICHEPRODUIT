# Copier vers .env et renseigner les valeurs réelles.
# Ne jamais committer le fichier .env.

# --- Runtime ---
PORT=3000
# production | preview | development — obligatoire en « production » sur Vercel prod
NODE_ENV=development
# Origines CORS séparées par des virgules. Obligatoire et non « * » si NODE_ENV=production.
CORS_ORIGIN=http://localhost:5173
# true derrière Vercel / reverse-proxy (rate-limit via X-Forwarded-For)
TRUST_PROXY=false
# Durée de vie du cookie session invité (secondes), défaut 30 jours
# GUEST_SESSION_COOKIE_MAX_AGE_SEC=2592000

# --- Supabase (obligatoire) ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiJ9.example-anon
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiJ9.example-service

# --- IA (obligatoire) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# --- Tavily suggest-urls (obligatoire) ---
TAVILY_API_KEY=tvly-...
# TAVILY_SEARCH_DEPTH=basic
# TAVILY_COUNTRY=france  (ou « none » pour désactiver)

# --- Stripe (optionnel en local — checkout indisponible si vide) ---
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_SUCCESS_URL=http://localhost:5173/billing/success
# STRIPE_CANCEL_URL=http://localhost:5173/billing/cancel
# STRIPE_PRICE_PLATINUM=price_...
