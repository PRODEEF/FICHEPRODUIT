{
  "name": "backend",
  "version": "0.0.1",
  "description": "NestJS backend with Fastify adapter",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "node node_modules/@nestjs/cli/bin/nest.js build",
    "build:clean": "node -e \"const fs=require('fs');try{fs.rmSync('dist',{recursive:true,force:true})}catch(e){};try{fs.unlinkSync('tsconfig.build.tsbuildinfo')}catch(e){}\" && node node_modules/@nestjs/cli/bin/nest.js build",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "start": "nest start",
    "prestart:dev": "node scripts/ensure-dist-built.mjs",
    "start:dev": "node scripts/nest-dev.mjs start --watch",
    "start:debug": "node scripts/nest-dev.mjs start --debug --watch",
    "start:prod": "node -r tsconfig-paths/register dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --max-warnings 0",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@fastify/cookie": "^10.0.1",
    "@fastify/cors": "^10.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/static": "10.1.2",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@supabase/supabase-js": "^2.95.3",
    "@vercel/functions": "^3.5.1",
    "cheerio": "^1.2.0",
    "csv-stringify": "^6.8.1",
    "nestjs-zod": "^5.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "stripe": "^18.5.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "glob": "^13.0.0",
    "test-exclude": "^7.0.1",
    "find-my-way": "^9.7.0",
    "@nestjs/swagger": {
      "js-yaml": "5.2.2"
    },
    "brace-expansion": "^5.0.8",
    "minimatch": "^10.0.3"
  },
  "devDependencies": {
    "@babel/types": "^7.28.0",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^10.8.0",
    "jest": "^30.4.0",
    "prettier": "^3.4.0",
    "source-map-support": "^0.5.21",
    "supabase": "^2.110.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.11",
    "ts-loader": "^9.5.0",
    "ts-node": "^10.9.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.59.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.service.ts",
      "!**/sub-services/**",
      "**/*.repository.ts",
      "**/guards/*.ts",
      "**/filters/*.ts",
      "core/scraper/scrape-url-policy.ts",
      "core/http/guest-session.ts"
    ],
    "coveragePathIgnorePatterns": [
      "\\.spec\\.ts$",
      "database\\.types\\.ts$"
    ],
    "coverageDirectory": "../coverage",
    "coverageThreshold": {
      "global": {
        "lines": 50,
        "functions": 50,
        "branches": 30,
        "statements": 50
      }
    },
    "testEnvironment": "node"
  }
}
