# Base URL du backend NestJS.
# Laisser vide pour utiliser le proxy Vite (`/api` → backend) : même origine, cookies invité httpOnly.
# VITE_API_URL=http://localhost:3000
#
# Preview Vercel (front et back sur deux projets) : définir sur le projet frontend Vercel
# (Environment → Preview) l’URL du backend preview, ex. :
VITE_API_URL=https://ficheproduit-backend-xxx.vercel.app

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# URL publique du frontend (liens e-mail reset mot de passe). Laisser vide = origine au runtime.
# VITE_SITE_URL=https://app.example.com

# E-mail de contact commercial (page tarifs — pack Business Custom)
# VITE_CONTACT_EMAIL=contact@example.com
