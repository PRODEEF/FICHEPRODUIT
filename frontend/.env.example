# Base URL du backend NestJS.
# Laisser vide pour utiliser le proxy Vite (`/api` → backend) : même origine, cookies invité httpOnly.
# VITE_API_URL=http://localhost:3000
VITE_API_URL=

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# URL publique du frontend (liens e-mail reset mot de passe). Laisser vide = origine au runtime.
# VITE_SITE_URL=https://app.example.com

# Crisp (https://help.crisp.chat/en/article/how-to-create-a-website-id-10wcj3l/)
# VITE_CRISP_WEBSITE_ID=your-crisp-website-id
