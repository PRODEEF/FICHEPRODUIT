# Copier vers .env et renseigner les valeurs réelles.
# Ne jamais committer le fichier .env.

# --- Supabase (obligatoire) ---
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiJ9.example-anon

# --- API backend ---
# Vide en local (proxy Vite /api → localhost:3000) — recommandé.
# Si tu forces une URL, utilise le MÊME hostname que le front
# (localhost avec localhost, pas 127.0.0.1) sinon le cookie invité ne part pas.
# En prod / preview cross-origin : URL publique du backend, sans slash final.
# VITE_API_URL=https://votre-backend.vercel.app

# --- Auth redirects (reset password, etc.) ---
# URL publique du frontend (sans slash final). Défaut : origine courante.
# VITE_SITE_URL=http://localhost:5173

# --- Optionnel ---
# VITE_CONTACT_EMAIL=contact@example.com
# VITE_SUGGEST_URLS_URL=
